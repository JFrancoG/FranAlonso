rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Temporary compatibility for the unauthenticated legacy application.
    // Remove these grants after the legacy Auth/App Check rollout is adopted.
    match /prod/prod/{document=**} {
      allow read, write: if true;
    }

    match /dev/dev/{document=**} {
      allow read, write: if true;
    }

    match /backup/backup/{document=**} {
      allow read, write: if true;
    }

    // The new develop/production namespaces and every unrelated path remain closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
