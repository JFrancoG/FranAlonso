    },
    "consent.summary.purposes.text" : {
      "comment" : "Resumen de finalidades del tratamiento.",
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gestionar la relación con el cliente, las citas, la prestación y seguimiento de los servicios, la facturación y las obligaciones legales. Solo si se autoriza: conservar una fotografía en la ficha interna y enviar comunicaciones comerciales."
          }
        }
      }
    },
    "consent.summary.recipients.label" : {
      "comment" : "Etiqueta de destinatarios en la primera capa del consentimiento.",
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Destinatarios"
          }
        }
      }
    },
    "consent.summary.recipients.text" : {
      "comment" : "Resumen de destinatarios y transferencias del tratamiento.",
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Administraciones públicas cuando exista obligación legal y proveedores que actúen como encargados del tratamiento. Las transferencias internacionales, si fueran necesarias, se realizarán con las garantías exigidas por la normativa."
          }
        }
      }
    },
    "consent.summary.rights.label" : {
      "comment" : "Etiqueta de derechos en la primera capa del consentimiento.",
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Derechos"
          }
        }
      }
    },
    "consent.summary.rights.text" : {
      "comment" : "Resumen del ejercicio de derechos del cliente.",
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acceso, rectificación, supresión, oposición, limitación y portabilidad, así como retirada del consentimiento, mediante los datos de contacto indicados. Puede reclamar ante la Agencia Española de Protección de Datos."
          }
