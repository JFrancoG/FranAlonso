          }
        }
      }
    },
    "consent.signature.notice" : {
      "comment" : "Aclaración legal situada antes del espacio de firma del consentimiento.",
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La firma acredita la recepción de esta información y, únicamente respecto de las casillas marcadas, el consentimiento correspondiente. Las casillas no marcadas equivalen a no autorizar. La retirada posterior del consentimiento no afectará a la licitud del tratamiento realizado con anterioridad ni a los tratamientos basados en contrato u obligación legal."
          }
        }
      }
    },
    "consent.summary.controller.label" : {
      "comment" : "Etiqueta de responsable en la primera capa del consentimiento.",
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Responsable"
          }
        }
