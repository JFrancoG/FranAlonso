{
  "sourceLanguage" : "es",
  "strings" : {
    "business.tax_identifier.label" : {
      "comment" : "Etiqueta fiscal situada antes del identificador tributario del negocio en la cabecera de ticket y factura.",
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NIF"
          }
        }
      }
    },
    "consent.details.automated_decisions.heading" : {
      "comment" : "Encabezado sobre decisiones automatizadas en la información adicional del consentimiento.",
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Decisiones automatizadas"
          }
        }
      }
    },
    "consent.details.automated_decisions.text" : {
      "comment" : "Declaración sobre decisiones automatizadas en el consentimiento.",
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se adoptan decisiones automatizadas ni se elaboran perfiles con efectos jurídicos o similares sobre el cliente."
          }
        }
      }
    },
    "consent.details.provenance.heading" : {
      "comment" : "Encabezado sobre procedencia y categorías de datos del consentimiento.",
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Procedencia y categorías de datos"
          }
        }
      }
    },
    "consent.details.provenance.text" : {
      "comment" : "Detalle de procedencia y categorías de datos del consentimiento.",
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los datos se obtienen directamente del cliente. Podrán tratarse datos identificativos y de contacto, citas, servicios y preferencias necesarias para su prestación, historial de atención, datos de facturación, preferencias de comunicaciones y, únicamente si se autoriza, una fotografía para la ficha interna."
          }
        }
      }
    },
    "consent.details.recipients.heading" : {
      "comment" : "Encabezado sobre destinatarios y transferencias del consentimiento.",
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Destinatarios y transferencias"
          }
        }
      }
    },
    "consent.details.recipients.text" : {
      "comment" : "Detalle sobre destinatarios y transferencias del consentimiento.",
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se comunicarán datos a terceros salvo obligación legal. Podrán acceder proveedores tecnológicos o profesionales que presten servicios por cuenta del responsable bajo el correspondiente contrato. Si alguno tratase datos fuera del Espacio Económico Europeo, se aplicará una decisión de adecuación u otra garantía válida y podrá solicitarse información adicional al responsable."
          }
        }
      }
    },
    "consent.details.requirement.heading" : {
      "comment" : "Encabezado sobre datos obligatorios y opcionales del consentimiento.",
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carácter obligatorio u opcional"
          }
        }
      }
    },
    "consent.details.requirement.text" : {
      "comment" : "Detalle sobre datos obligatorios y opcionales del consentimiento.",
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los datos identificados como obligatorios son necesarios para prestar el servicio o cumplir obligaciones legales; no facilitarlos puede impedir la contratación o facturación. La fotografía y las comunicaciones comerciales son opcionales y su rechazo no afecta al servicio."
          }
        }
      }
    },
    "consent.details.retention.heading" : {
      "comment" : "Encabezado sobre conservación de datos del consentimiento.",
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conservación"
          }
        }
      }
    },
    "consent.details.retention.text" : {
      "comment" : "Detalle sobre conservación de datos del consentimiento.",
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los datos se conservarán mientras exista relación con el cliente y, después, durante los plazos necesarios para atender obligaciones legales y posibles responsabilidades. Los tratamientos basados en consentimiento se mantendrán hasta su retirada, sin perjuicio de la conservación estrictamente necesaria para acreditar su gestión."
          }
        }
      }
    },
    "consent.details.rights.heading" : {
      "comment" : "Encabezado sobre derechos y reclamaciones del consentimiento.",
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Derechos y reclamaciones"
          }
        }
      }
    },
    "consent.details.rights.text" : {
      "comment" : "Detalle sobre el ejercicio de derechos y reclamaciones del consentimiento.",
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puede ejercer los derechos de acceso, rectificación, supresión, oposición, limitación y portabilidad, o retirar un consentimiento, escribiendo a info@franalonsopeluqueros.com o a c/ Bailén, 33-35. Local Bajo. 41001. Sevilla (España), acreditando su identidad cuando sea necesario. También puede presentar una reclamación ante la Agencia Española de Protección de Datos (www.aepd.es)."
          }
        }
      }
    },
    "consent.field.client_identifier" : {
      "comment" : "Etiqueta del documento identificativo del cliente en el consentimiento.",
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DNI/NIE"
          }
        }
      }
    },
    "consent.field.client_name" : {
      "comment" : "Etiqueta de nombre completo del cliente en el consentimiento.",
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nombre y apellidos"
          }
        }
      }
    },
    "consent.field.client_signature" : {
      "comment" : "Etiqueta del espacio para la firma del cliente.",
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Firma del cliente"
          }
        }
      }
    },
    "consent.introduction" : {
      "comment" : "Introducción normativa del consentimiento de clientes.",
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De conformidad con el Reglamento (UE) 2016/679 General de Protección de Datos (RGPD) y la Ley Orgánica 3/2018, de 5 de diciembre, de Protección de Datos Personales y garantía de los derechos digitales (LOPDGDD), se facilita la siguiente información sobre el tratamiento de los datos personales del cliente."
          }
        }
      }
    },
    "consent.optional.marketing_electronic" : {
      "comment" : "Consentimiento opcional para comunicaciones comerciales electrónicas.",
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deseo recibir comunicaciones comerciales por medios electrónicos, como correo electrónico, SMS o mensajería."
          }
        }
      }
    },
    "consent.optional.marketing_phone_postal" : {
      "comment" : "Consentimiento opcional para comunicaciones comerciales telefónicas o postales.",
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deseo recibir comunicaciones comerciales por teléfono o correo postal."
          }
        }
      }
    },
    "consent.optional.photo" : {
      "comment" : "Consentimiento opcional para conservar una fotografía en la ficha interna.",
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorizo la conservación de una fotografía en mi ficha interna exclusivamente para gestionar y realizar el seguimiento de los servicios solicitados."
          }
        }
      }
    },
    "consent.section.additional" : {
