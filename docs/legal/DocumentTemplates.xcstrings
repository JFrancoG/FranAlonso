        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Medidas precontractuales y ejecución del servicio, cumplimiento de obligaciones legales y consentimiento para las finalidades opcionales."
          }
        }
      }
    },
    "consent.summary.purposes.label" : {
      "comment" : "Etiqueta de finalidades en la primera capa del consentimiento.",
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
