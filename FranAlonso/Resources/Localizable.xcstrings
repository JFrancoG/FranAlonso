    "stock.adjustment.frozen": {
      "comment": "Stock adjustment screen: frozen",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reintentar registrará este mismo ajuste. Para cambiar los datos, cancela y abre un ajuste nuevo."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retry will record this same adjustment. To change the details, cancel and open a new adjustment."
          }
        }
      }
    },
