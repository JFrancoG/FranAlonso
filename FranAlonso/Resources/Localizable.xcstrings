  "sales.history.voided.message": {
    "comment": "Sales history: voided.message",
    "extractionState": "manual",
    "localizations": {
      "es": {
        "stringUnit": {
          "state": "translated",
          "value": "Venta anulada. Se conservan el pago, el documento y los importes originales; la anulación tiene su propia referencia y fecha."
        }
      },
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Voided sale. The original payment, document and amounts are retained; the reversal has its own reference and date."
        }
      }
    }
  },
