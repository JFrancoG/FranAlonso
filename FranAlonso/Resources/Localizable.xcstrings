    "stock.adjustment.discardMessage": {
      "comment": "Stock adjustment screen: discardMessage",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los datos de este ajuste no se conservarán. Los movimientos ya registrados se mantienen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This adjustment draft will be discarded. Previously recorded movements are kept."
          }
        }
      }
    },
