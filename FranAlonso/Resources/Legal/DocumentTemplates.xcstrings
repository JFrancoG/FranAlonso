{
  "sourceLanguage": "es",
  "strings": {
    "business.tax_identifier.label": {
      "comment": "Etiqueta fiscal situada antes del identificador tributario del negocio en la cabecera de ticket y factura.",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "NIF"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "NIF"
          }
        }
      }
    },
    "consent.details.additional.heading": {
      "comment": "Encabezado de información adicional pendiente de concretar antes de uso real.",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Información adicional pendiente de completar"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Additional information to be completed"
          }
        }
      }
    },
    "consent.details.additional.text": {
      "comment": "Información adicional y nota editorial de revisión de transferencias del borrador de consentimiento.",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los datos proceden del cliente. No se toman decisiones exclusivamente automatizadas con efectos jurídicos o similares sobre él. [Antes de utilizar este texto: completar la información sobre transferencias internacionales y garantías con los proveedores y servicios realmente configurados; no afirmar su ausencia sin verificarla.]"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The data comes from the client. We do not make decisions based solely on automated processing that have legal or similarly significant effects on them. [Before using this text: complete the information about international transfers and safeguards based on the providers and services actually configured; do not claim that there are none without verifying this.]"
          }
        }
      }
    },
    "consent.details.provenance.heading": {
      "comment": "Encabezado sobre procedencia y categorías de datos del consentimiento.",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Qué datos recogemos"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What data we collect"
          }
        }
      }
    },
    "consent.details.provenance.text": {
      "comment": "Detalle de procedencia y categorías de datos del consentimiento.",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los facilitas tú: datos de identificación y contacto y la información necesaria sobre citas, servicios y facturación. Solo te pediremos los datos necesarios para cada finalidad. El email para recibir el ticket o la factura y la fotografía son opcionales; puedes recibir el servicio sin autorizar una fotografía."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You provide it: identification and contact details, and the information needed for appointments, services and billing. We will only ask for the data needed for each purpose. An email address to receive a receipt or invoice and a photo are optional; you can receive the service without authorizing a photo."
          }
        }
      }
    },
    "consent.details.recipients.heading": {
      "comment": "Encabezado sobre destinatarios y transferencias del consentimiento.",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quién puede acceder"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Who can access it"
          }
        }
      }
    },
    "consent.details.recipients.text": {
      "comment": "Detalle sobre destinatarios y transferencias del consentimiento.",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El responsable y las personas autorizadas para atenderte, así como proveedores que presten servicios por cuenta del negocio con las garantías correspondientes. Podremos comunicar datos a las administraciones cuando exista una obligación legal. No publicaremos tu fotografía ni la utilizaremos con fines publicitarios."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The controller and the people authorized to assist you, as well as providers acting on behalf of the business with the appropriate safeguards. We may disclose data to public authorities when required by law. We will not publish your photo or use it for advertising."
          }
        }
      }
    },
    "consent.details.retention.heading": {
      "comment": "Encabezado sobre conservación de datos del consentimiento.",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Durante cuánto tiempo"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How long we keep it"
          }
        }
      }
    },
    "consent.details.retention.text": {
      "comment": "Detalle sobre conservación de datos del consentimiento.",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conservaremos los datos mientras sean necesarios para las finalidades indicadas y, posteriormente, los que debamos mantener por obligaciones legales o para atender posibles responsabilidades. La fotografía se conservará mientras resulte necesaria para la finalidad autorizada y no retires el consentimiento."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We will keep the data for as long as it is needed for the stated purposes and, afterwards, retain any data required by law or to address potential liabilities. The photo will be kept for as long as it is needed for the authorized purpose and you have not withdrawn your consent."
          }
        }
      }
    },
    "consent.details.rights.heading": {
      "comment": "Encabezado sobre derechos y reclamaciones del consentimiento.",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus derechos"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your rights"
          }
        }
      }
    },
    "consent.details.rights.text": {
      "comment": "Detalle sobre el ejercicio de derechos y reclamaciones del consentimiento.",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes solicitar acceso, rectificación o supresión de tus datos, así como ejercer los demás derechos que correspondan, incluidos limitación, oposición y portabilidad, a través de los datos de contacto anteriores. Puedes retirar la autorización de la fotografía en cualquier momento por esos mismos medios, sin afectar al servicio. La retirada no afecta a la licitud de su uso anterior. Puedes reclamar ante la Agencia Española de Protección de Datos (www.aepd.es)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can request access to, rectification or erasure of your data, and exercise any other applicable rights, including restriction, objection and portability, using the contact details above. You can withdraw photo authorization at any time through the same channels without affecting the service. Withdrawal does not affect the lawfulness of its previous use. You can lodge a complaint with the Spanish Data Protection Agency (www.aepd.es)."
          }
        }
      }
    },
    "consent.field.client_name": {
      "comment": "Etiqueta de nombre completo del cliente en el consentimiento.",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nombre y apellidos"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Full name"
          }
        }
      }
    },
    "consent.field.client_signature": {
      "comment": "Etiqueta del espacio para la firma del cliente.",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Firma del cliente"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Client signature"
          }
        }
      }
    },
    "consent.introduction": {
      "comment": "Introducción normativa del consentimiento de clientes.",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Información sobre el uso de tus datos en Fran Alonso Peluqueros y autorización opcional para conservar una fotografía en tu ficha interna."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Information about how your data is used at Fran Alonso Peluqueros and optional authorization to keep a photo in your internal client record."
          }
        }
      }
    },
    "consent.optional.photo": {
      "comment": "Consentimiento opcional para conservar una fotografía en la ficha interna.",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorizo a conservar una fotografía en mi ficha interna para gestionar y realizar el seguimiento de los servicios que solicito. Esta autorización no incluye su publicación ni su uso publicitario."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I authorize a photo to be kept in my internal client record to manage and follow up on the services I request. This authorization does not include publication or use for advertising."
          }
        }
      }
    },
    "consent.section.additional": {
      "comment": "Título de la segunda capa de información del consentimiento.",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Información adicional"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Additional information"
          }
        }
      }
    },
    "consent.section.basic": {
      "comment": "Título de la primera capa de información del consentimiento.",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Información básica"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Basic information"
          }
        }
      }
    },
    "consent.section.optional_consents": {
      "comment": "Título de los consentimientos opcionales.",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografía opcional para tu ficha"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional photo for your client record"
          }
        }
      }
    },
    "consent.signature.notice": {
      "comment": "Explica foto no autorizada por defecto y constancia de recepción mediante firma.",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No marcar esta opción significa que no autorizas la fotografía. Puedes continuar sin marcarla. Con mi firma dejo constancia de haber recibido esta información. La autorización para conservar una fotografía se limita a la opción anterior y solo se concede si la he marcado."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leaving this option unchecked means that you do not authorize the photo. You can continue without selecting it. By signing, I acknowledge receipt of this information. Authorization to keep a photo is limited to the option above and is only granted if I have selected it."
          }
        }
      }
    },
    "consent.summary.controller.label": {
      "comment": "Etiqueta de responsable en la primera capa del consentimiento.",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Responsable"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Controller"
          }
        }
      }
    },
    "consent.summary.controller.text": {
      "comment": "Identidad resumida del responsable en el consentimiento.",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Francisco Alonso Domínguez (Fran Alonso Peluqueros), NIF 48.815.877-X. Contacto: info@franalonsopeluqueros.com. Dirección: c/ Bailén, 33-35. Local Bajo. 41001. Sevilla (España)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Francisco Alonso Domínguez (Fran Alonso Peluqueros), NIF 48.815.877-X. Contact: info@franalonsopeluqueros.com. Address: c/ Bailén, 33-35. Ground floor premises. 41001. Sevilla (Spain)."
          }
        }
      }
    },
    "consent.summary.lawful_basis.label": {
      "comment": "Etiqueta de legitimación en la primera capa del consentimiento.",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por qué podemos tratarlos"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Legal basis for processing"
          }
        }
      }
    },
    "consent.summary.lawful_basis.text": {
      "comment": "Resumen de bases jurídicas del tratamiento.",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los datos necesarios para prestar el servicio se tratan para gestionar esa relación; los exigidos por la normativa, para cumplir las obligaciones legales correspondientes. La fotografía de la ficha es opcional y solo se conservará si la autorizas mediante la opción que aparece al final."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The data needed to provide the service is processed to manage that relationship; data required by law is processed to meet the corresponding legal obligations. The photo in the client record is optional and will only be kept if you authorize it using the option at the end."
          }
        }
      }
    },
    "consent.summary.purposes.label": {
      "comment": "Etiqueta de finalidades en la primera capa del consentimiento.",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para qué utilizamos tus datos"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How we use your data"
          }
        }
      }
    },
    "consent.summary.purposes.text": {
      "comment": "Resumen de finalidades del tratamiento.",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para gestionar tu ficha, las citas y los datos necesarios para prestar y realizar el seguimiento de los servicios que solicitas; emitir los documentos de facturación y cumplir las obligaciones legales. Si nos pides recibir el ticket o la factura por correo electrónico, utilizaremos la dirección que facilites para ese envío. No utilizaremos tus datos para enviarte publicidad ni comunicaciones comerciales."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To manage your client record, appointments and the information needed to provide and follow up on the services you request; issue billing documents and meet legal obligations. If you ask to receive a receipt or invoice by email, we will use the address you provide for that delivery. We will not use your data to send advertising or commercial communications."
          }
        }
      }
    },
    "consent.title": {
      "comment": "Título principal de la hoja de información y consentimientos de clientes.",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Información sobre datos y fotografía opcional"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Data information and optional photo"
          }
        }
      }
    },
    "data_information.introduction": {
      "comment": "Introducción del documento informativo de ficha y facturación.",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te explicamos cómo utilizamos tus datos para atenderte, gestionar tu ficha y emitir tus documentos de facturación."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We explain how we use your data to assist you, manage your client record and issue your billing documents."
          }
        }
      }
    },
    "data_information.lawful_basis": {
      "comment": "Bases del tratamiento necesario para servicio y obligaciones legales.",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los datos necesarios para prestar el servicio se tratan para gestionar esa relación; los exigidos por la normativa, para cumplir las obligaciones legales correspondientes."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The data needed to provide the service is processed to manage that relationship; data required by law is processed to meet the corresponding legal obligations."
          }
        }
      }
    },
    "data_information.provenance": {
      "comment": "Categorías de datos y carácter opcional del email para documentos solicitados.",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los facilitas tú: datos de identificación y contacto y la información necesaria sobre citas, servicios y facturación. Solo te pediremos los datos necesarios para cada finalidad. El email es opcional y se utiliza para enviarte el ticket o la factura cuando lo solicitas."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You provide it: identification and contact details, and the information needed for appointments, services and billing. We will only ask for the data needed for each purpose. Email is optional and is used to send you a receipt or invoice when you request it."
          }
        }
      }
    },
    "data_information.recipients": {
      "comment": "Destinatarios de los datos necesarios para prestar el servicio.",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El responsable y las personas autorizadas para atenderte, así como proveedores que presten servicios por cuenta del negocio con las garantías correspondientes. Podremos comunicar datos a las administraciones cuando exista una obligación legal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The controller and the people authorized to assist you, as well as providers acting on behalf of the business with the appropriate safeguards. We may disclose data to public authorities when required by law."
          }
        }
      }
    },
    "data_information.retention": {
      "comment": "Criterios de conservación del documento informativo sin autorización de fotografía.",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conservaremos los datos mientras sean necesarios para las finalidades indicadas y, posteriormente, los que debamos mantener por obligaciones legales o para atender posibles responsabilidades."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We will keep the data for as long as it is needed for the stated purposes and, afterwards, retain any data required by law or to address potential liabilities."
          }
        }
      }
    },
    "data_information.rights": {
      "comment": "Derechos y reclamación del documento informativo de ficha y facturación.",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes solicitar acceso, rectificación o supresión de tus datos, así como ejercer los demás derechos que correspondan, incluidos limitación, oposición y portabilidad, a través de los datos de contacto anteriores. Puedes reclamar ante la Agencia Española de Protección de Datos (www.aepd.es)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can request access to, rectification or erasure of your data, and exercise any other applicable rights, including restriction, objection and portability, using the contact details above. You can lodge a complaint with the Spanish Data Protection Agency (www.aepd.es)."
          }
        }
      }
    },
    "data_information.signature_notice": {
      "comment": "La firma deja constancia de recepción de información; no solicita un consentimiento genérico.",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con mi firma dejo constancia de haber recibido la información anterior sobre el tratamiento de mis datos personales."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "By signing, I acknowledge receipt of the information above about the processing of my personal data."
          }
        }
      }
    },
    "data_information.title": {
      "comment": "Título del borrador informativo para una ficha sin fotografía.",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Información sobre tus datos personales"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Information about your personal data"
          }
        }
      }
    },
    "document.field.date": {
      "comment": "Etiqueta de fecha común a documentos de facturación y consentimiento.",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fecha"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Date"
          }
        }
      }
    },
    "document.page.label": {
      "comment": "Palabra que precede al número de página en documentos PDF.",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Página"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Page"
          }
        }
      }
    },
    "document.review.status": {
      "comment": "Aviso visible que impide confundir las plantillas con documentos jurídicamente aprobados.",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "BORRADOR PENDIENTE DE REVISIÓN JURÍDICA"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DRAFT PENDING LEGAL REVIEW"
          }
        }
      }
    },
    "document.signature.optional": {
      "comment": "Etiqueta del área opcional donde el renderer puede colocar la firma y el sello del negocio.",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Firma y sello (opcional)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signature and stamp (optional)"
          }
        }
      }
    },
    "document.template.provisional_badge": {
      "comment": "Aviso visible en las plantillas provisionales de ticket y factura.",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "PLANTILLA PROVISIONAL"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PROVISIONAL TEMPLATE"
          }
        }
      }
    },
    "document.total.taxable_base": {
      "comment": "Etiqueta del total de base imponible.",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Base imponible"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Taxable amount"
          }
        }
